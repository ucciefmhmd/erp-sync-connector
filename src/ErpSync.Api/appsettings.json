{
  "ConnectionStrings": {
    "ErpSync": "Data Source=erpsync.db"
  },
  "Erp": {
    "BaseUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "AttemptTimeout": "00:00:10",
    "TotalTimeout": "00:00:45",
    "MaxRetryAttempts": 3
  },
  "Authentication": {
    "ApiClients": []
  },
  "Sync": {
    "PageSize": 200,
    "FeedOverlap": "00:02:00",
    "ProductsInterval": "00:05:00",
    "StockInterval": "00:01:00",
    "CustomersInterval": "00:15:00"
  },
  "Orders": {
    "MaxAttempts": 8,
    "BaseRetryDelay": "00:00:10",
    "MaxRetryDelay": "00:15:00",
    "AttemptLease": "00:05:00",
    "DispatchBatchSize": 25,
    "DispatchPollInterval": "00:00:15",
    "ValidateAgainstCatalog": true
  },
  "RateLimiting": {
    "PermitPerMinute": 120
  },
  "Workers": {
    "Enabled": true
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
