<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test method names use underscores for readability -->
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared fake ERP, compiled into both test projects -->
    <Compile Include="..\ErpSync.UnitTests\Fakes\FakeErpClient.cs" Link="Fakes\FakeErpClient.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ErpSync.Api\ErpSync.Api.csproj" />
  </ItemGroup>
</Project>
